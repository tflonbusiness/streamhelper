# Copy to .env on the VPS: cp .env.production.example .env

# Public URL (HTTPS required for auth cookies in production)
APP_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com

# Generate: openssl rand -hex 32
SESSION_SECRET=change-me

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=caz_agent

# Kick OAuth + webhooks
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=https://your-domain.com/auth/oauth/kick/callback
KICK_WEBHOOK_PUBLIC_URL=https://your-domain.com

# Optional
HTTP_PORT=80
