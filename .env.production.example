# Local: cp .env.production.example .env.production (gitignored), then fill in values.
# VPS: cp .env.production.example .env
# Run prod stack: docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# Public URL (HTTPS required for auth cookies in production)
APP_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com

# Generate: openssl rand -hex 32
SESSION_SECRET=change-me

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=caz_agent

# Kick OAuth + webhooks
KICK_CLIENT_ID=01M2DBX0F07JARJ63J1DB7BAH6
KICK_CLIENT_SECRET=b2d54cb8779923f5d7e870d1b3f7ffa0599c3454717ca853bdeb8244384b52e4
KICK_REDIRECT_URI=http://localhost:5173/auth/oauth/kick/callback
KICK_WEBHOOK_PUBLIC_URL=https://your-domain.com

# Optional
HTTP_PORT=80
