# Локально: cp .env.production.example .env.production (в gitignore), заполнить значения.
# VPS: скопировать .env.production на сервер (см. docs/obnovlenie-env-production.md).
# Деплой: docs/deploy-vps.md
# Запуск: docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# Public URL (HTTPS required for auth cookies in production)
APP_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com

# Generate: openssl rand -hex 32
SESSION_SECRET=change-me

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=caz_agent

# Kick OAuth + webhooks
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=https://your-domain.com/auth/oauth/kick/callback
KICK_WEBHOOK_PUBLIC_URL=https://your-domain.com

# Optional
HTTP_PORT=80
