# App
APP_URL=http://localhost:5173
SESSION_SECRET=change-me-in-production

# Database (schema via SQL migrations in server/migrations — applied on server start or `npm run db:migrate`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/caz_agent

# Kick OAuth scopes include channel:rewards:read (Media Interactive reward picker).
# Re-login via Kick after changing app permissions in Kick Developer.

# Kick OAuth (required — real integration is the default)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:5173/auth/oauth/kick/callback

# Local dev only — skip Kick and use mock-kick-code login
# KICK_OAUTH_MOCK=true

# Kick chat bot — mock mode skips webhook signature + uses POST /dev/kick/chat
# KICK_CHAT_MOCK=true

# Development only (NODE_ENV !== production): [kick:dev] console logs for webhook
# ingress, payloads, and routing actions. Set false to silence.
# KICK_WEBHOOK_DEBUG=false

# Testing only — skip Kick RSA webhook signature (e.g. proxy re-serializes JSON). Do not use in production.
# KICK_WEBHOOK_SKIP_VERIFY=true

# Optional override; default is fetched from https://api.kick.com/public/v1/public-key on startup
# KICK_WEBHOOK_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Re-fetch public key from Kick API (ms). Default 10800000 (3h). Set 0 to disable scheduled refresh.
# KICK_WEBHOOK_PUBLIC_KEY_REFRESH_MS=10800000

# Public URL for Kick webhooks (Cloudflare Tunnel in local dev)
# Example: https://caz-agent-dev.your-subdomain.workers.dev
# KICK_WEBHOOK_PUBLIC_URL=https://your-tunnel.example.com
